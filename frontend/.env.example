# ── CreatorLoop Frontend — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ───────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Development: http://localhost:8000
# Production:  https://your-api.railway.app  or  https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# ── Google OAuth ────────────────────────────────────────────────────────────────
# Required to enable the "Continue with Google" button on sign-in / sign-up.
# Leave empty to show the button in a non-functional informational state.
#
# How to get your Client ID:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID  →  Web application
#   3. Add Authorized JavaScript origins:
#        http://localhost:5173          (development)
#        https://your-domain.vercel.app (production)
#   4. No redirect URIs needed (we use the popup / implicit flow)
#   5. Copy the Client ID below
#
VITE_GOOGLE_CLIENT_ID=
